#!/usr/bin/env node
// gmail-send：让容器里的 Agent 用主人的 Gmail 发一封邮件。
// 邮箱的登录凭据不在容器里：邮件内容被提交给容器外的"审批中间人"，由它来发。
//   发给主人自己（发件邮箱本身）：直接发出。
//   发给其他任何人：先出现在主人的调度台上，主人点了"允许"才会发。
// 用法：
//   gmail-send --status
//   gmail-send --to someone@example.com [--to another@example.com] --subject "标题" --body "正文" [--attach /workspace/文件 ...] [--why "为什么要发"]
//   正文也可以用 --body-file /workspace/正文.md，或者从标准输入传进来。
const http = require('http');
const fs = require('fs');

const SOCKET = process.env.OPS_SOCKET || '/home/agent/.ops/ops.sock';
const WAIT_MS = 16 * 60 * 1000;

function call(method, path, body) {
  return new Promise((resolve, reject) => {
    const data = body ? Buffer.from(JSON.stringify(body)) : null;
    const req = http.request({ socketPath: SOCKET, path, method, headers: data ? { 'Content-Type': 'application/json', 'Content-Length': data.length } : {} }, (res) => {
      let s = '';
      res.on('data', (c) => { s += c; });
      res.on('end', () => { try { resolve({ status: res.statusCode, body: JSON.parse(s || '{}') }); } catch (e) { reject(new Error('审批服务返回了无法识别的内容')); } });
    });
    req.on('error', () => reject(new Error('连不上审批服务（' + SOCKET + '）。发邮件功能可能没有启用。')));
    if (data) req.write(data);
    req.end();
  });
}
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const say = (s) => process.stderr.write('[gmail-send] ' + s + '\n');
const readStdin = () => new Promise((resolve) => { let s = ''; process.stdin.setEncoding('utf8'); process.stdin.on('data', (c) => { s += c; }).on('end', () => resolve(s)); });

(async () => {
  const argv = process.argv.slice(2);
  if (!argv.length || argv.includes('-h') || argv.includes('--help')) {
    console.log('用法：\n  gmail-send --status\n  gmail-send --to 收件人 [--to 收件人2] --subject "标题" --body "正文" [--body-file 文件] [--html-file 排好版的正文.html] [--attach /workspace/文件] [--why "为什么要发"]\n发给主人自己的直接发出；发给其他人的要主人在调度台上批准。');
    process.exit(argv.length ? 0 : 2);
  }
  if (argv.includes('--status')) {
    const r = (await call('GET', '/mail/status')).body;
    console.log(r.configured ? '已配置，发件邮箱：' + r.address + '（发给这个地址的邮件不需要审批）' : '主人还没有配置 Gmail 账号，现在发不了邮件。');
    return;
  }
  const to = [], attachments = [];
  let subject = '', body = null, bodyFile = '', why = '', htmlFile = '', html;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i], v = argv[i + 1];
    if (a === '--to') { to.push(...String(v || '').split(',').map((x) => x.trim()).filter(Boolean)); i++; }
    else if (a === '--subject') { subject = v || ''; i++; }
    else if (a === '--body') { body = v || ''; i++; }
    else if (a === '--body-file') { bodyFile = v || ''; i++; }
    else if (a === '--html-file') { htmlFile = v || ''; i++; }
    else if (a === '--attach') { attachments.push(v || ''); i++; }
    else if (a === '--why') { why = v || ''; i++; }
    else { say('不认识的参数：' + a); process.exit(2); }
  }
  if (bodyFile) { try { body = fs.readFileSync(bodyFile, 'utf8'); } catch (e) { say('读不到正文文件：' + bodyFile); process.exit(2); } }
  if (htmlFile) { try { html = fs.readFileSync(htmlFile, 'utf8'); } catch (e) { say('读不到 HTML 正文文件：' + htmlFile); process.exit(2); } }
  if (body === null && !process.stdin.isTTY) body = await readStdin();
  if (!to.length || !subject || !body || !body.trim()) { say('缺少收件人、标题或正文。用 --help 看用法。'); process.exit(2); }

  const created = await call('POST', '/mail', { to, subject, body, attachments, why, html });
  if (created.status !== 200) { say('没有提交成功：' + (created.body.error || created.status)); process.exit(2); }
  const id = created.body.id;
  if (created.body.auto) say('这封邮件不需要审批，直接发送…');
  else { say('这封邮件要发给别人，已提交给主人审批：' + to.join('、') + '　标题：' + subject); say('等待主人在调度台上批准…（最多等 15 分钟）'); }
  const started = Date.now();
  let announced = Boolean(created.body.auto);
  for (;;) {
    await sleep(1500);
    const r = (await call('GET', '/result?id=' + id)).body;
    if (r.status === 'pending') { if (Date.now() - started > WAIT_MS) { say('等待超时。'); process.exit(4); } continue; }
    if (r.status === 'denied') { say('主人没有同意发这封邮件。不要换个写法重试，停下来向主人说明你想发什么、为什么。'); process.exit(3); }
    if (r.status === 'expired') { say('超过 15 分钟没有人批准，这次请求已作废，邮件没有发出。'); process.exit(4); }
    if (r.status === 'running') { if (!announced) { say('已批准，正在发送…'); announced = true; } continue; }
    if (r.status === 'done') {
      if (r.stdout) console.log(r.stdout);
      if (r.stderr) process.stderr.write(r.stderr + '\n');
      process.exit(r.exitCode === 0 ? 0 : 1);
    }
  }
})().catch((e) => { say(e.message); process.exit(5); });
